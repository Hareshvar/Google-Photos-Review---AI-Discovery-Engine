# ==============================================================================
# AI Discovery Engine ("Retrieval Lens") - Environment Variables Example
# ==============================================================================
# Copy this file to '.env' and fill in your API keys before running the application.

# ------------------------------------------------------------------------------
# Primary LLM Provider: Google Gemini
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIEBREAKER_MODEL=gemini-1.5-pro

# ------------------------------------------------------------------------------
# Secondary LLM Provider: Groq (Fallback Tagger & Judge A)
# ------------------------------------------------------------------------------
# Get your API key from Groq Console: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Local Vector Database & Embeddings Configuration
# ------------------------------------------------------------------------------
CHROMA_DB_DIR=./data/chroma_db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------------------------
# Application Environment & Server Settings
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DEMO_DATA_MODE=false
